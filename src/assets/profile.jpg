<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 800" width="600" height="800">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a101f"/>
      <stop offset="50%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#1e1b4b"/>
    </linearGradient>
    <linearGradient id="neon" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#06b6d4"/>
      <stop offset="100%" stop-color="#6366f1"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="30%" r="50%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="600" height="800" fill="url(#bg)"/>
  <circle cx="300" cy="280" r="240" fill="url(#glow)"/>
  
  <!-- Subtle circuit grid lines -->
  <path d="M50 150 L200 150 L250 200" stroke="#06b6d4" stroke-width="1.5" stroke-opacity="0.3" fill="none"/>
  <path d="M550 150 L400 150 L350 200" stroke="#6366f1" stroke-width="1.5" stroke-opacity="0.3" fill="none"/>
  <circle cx="250" cy="200" r="3" fill="#06b6d4"/>
  <circle cx="350" cy="200" r="3" fill="#6366f1"/>

  <!-- Developer Silhouette with glasses & posture -->
  <g transform="translate(0, 40)">
    <!-- Shoulders / Jacket -->
    <path d="M120 720 C130 540, 200 480, 300 480 C400 480, 470 540, 480 720 Z" fill="#1e293b" stroke="#334155" stroke-width="2"/>
    <path d="M220 480 L300 580 L380 480 Z" fill="#0f172a" stroke="#06b6d4" stroke-width="1" stroke-opacity="0.4"/>
    
    <!-- Neck -->
    <rect x="260" y="380" width="80" height="110" rx="20" fill="#fcd34d" fill-opacity="0.85"/>
    
    <!-- Head / Face -->
    <ellipse cx="300" cy="290" rx="95" ry="125" fill="#fcd34d" fill-opacity="0.9"/>
    
    <!-- Hair -->
    <path d="M195 270 C190 170, 250 140, 300 140 C360 140, 410 170, 405 270 C390 200, 350 170, 300 170 C240 170, 210 210, 195 270 Z" fill="#1e293b"/>
    
    <!-- Modern Tech Glasses -->
    <rect x="220" y="270" width="65" height="42" rx="10" fill="none" stroke="#06b6d4" stroke-width="5"/>
    <rect x="315" y="270" width="65" height="42" rx="10" fill="none" stroke="#06b6d4" stroke-width="5"/>
    <line x1="285" y1="290" x2="315" y2="290" stroke="#06b6d4" stroke-width="4"/>
    <line x1="200" y1="285" x2="220" y2="285" stroke="#06b6d4" stroke-width="3"/>
    <line x1="380" y1="285" x2="400" y2="285" stroke="#06b6d4" stroke-width="3"/>
    
    <!-- Glasses Reflection -->
    <path d="M230 280 L260 280 L245 305 L230 305 Z" fill="#ffffff" fill-opacity="0.3"/>
    <path d="M325 280 L355 280 L340 305 L325 305 Z" fill="#ffffff" fill-opacity="0.3"/>
    
    <!-- Eyes behind glasses -->
    <circle cx="252" cy="291" r="5" fill="#0f172a"/>
    <circle cx="348" cy="291" r="5" fill="#0f172a"/>
    
    <!-- Smile -->
    <path d="M275 350 Q300 368 325 350" fill="none" stroke="#78350f" stroke-width="3.5" stroke-linecap="round"/>
  </g>
  
  <!-- Subtle Badge at Bottom -->
  <g transform="translate(180, 720)">
    <rect width="240" height="42" rx="21" fill="#0f172a" fill-opacity="0.9" stroke="url(#neon)" stroke-width="1.5"/>
    <text x="120" y="26" fill="#38bdf8" font-family="monospace" font-size="14" font-weight="bold" text-anchor="middle">PORTFOLIO CREATOR</text>
  </g>
</svg>